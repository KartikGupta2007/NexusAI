# ==============================================================================
#  SECTION 1 — LOCAL DEVELOPMENT
#  Copy this file to .env. As it stands it is already correct for `npm run dev`:
#  nothing needs filling in.
# ==============================================================================

# Origin of the NexusAI backend: scheme and host only, no /api/v1 and no
# trailing slash — the client appends the path itself.
#
# Empty is the local answer. `npm run dev` then proxies /api to
# DEV_API_PROXY_TARGET below, which keeps requests same-origin and so keeps the
# auth cookies first-party — that is what lets a development backend issue
# SameSite=Lax cookies over plain HTTP. Pointing this at a local backend
# instead would make every request cross-site and sign-in would stop working.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api. Change it if your backend runs on another
# port. Never reaches the browser: no VITE_ prefix, so Vite does not inline it,
# and it is read in vite.config.ts alone.
DEV_API_PROXY_TARGET=http://127.0.0.1:3003


# ==============================================================================
#  SECTION 2 — DEPLOYMENT (frontend on Vercel, backend on Render)
#
#  Leave VITE_API_BASE_URL EMPTY in production too. That is not an oversight:
#  vercel.json rewrites /api/* to the Render service, so the browser only ever
#  talks to the Vercel origin and the session cookies stay FIRST-PARTY.
#
#  Pointing this at the Render URL instead is what breaks sign-in. The cookies
#  are correct either way — Secure, SameSite=None — but a page on vercel.app
#  calling onrender.com makes them third-party, and every browser that blocks
#  third-party cookies (Safari and Firefox always, Chrome in Incognito or with
#  the setting on) silently drops them. The symptom is not an error: password
#  sign-in appears to work, because the user comes back in the response body,
#  and then every authenticated call 401s, the history stays empty, a reload
#  signs you out, and Google sign-in loops back to the login page.
#
#  The dev proxy in vite.config.ts exists for exactly this reason. vercel.json
#  is the same arrangement in production.
#
#  Change the host in frontend/vercel.json to match your Render service —
#  Vercel does not interpolate environment variables into that file.
# ==============================================================================

# VITE_API_BASE_URL=

# On Render, the API must know it is reached at the Vercel origin, because that
# is the host the browser stands on and the host the OAuth callback returns to.
# From backend/.env.example SECTION 2:
#   NODE_ENV=production
#   HOST=0.0.0.0
#   CORS_ORIGINS=https://<your-app>.vercel.app
#   APP_ORIGIN=https://<your-app>.vercel.app
#   API_ORIGIN=https://<your-app>.vercel.app      <- the proxy origin, NOT the
#                                                    onrender.com host
#
# And in the Neon Console, the Auth project's trusted domains must include
#   https://<your-app>.vercel.app
# or POST /sign-in/social answers 403 INVALID_CALLBACKURL and Google sign-in
# fails with NEON_AUTH_START_FAILED before it ever reaches Google.
