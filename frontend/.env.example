# ==============================================================================
#  SECTION 1 — LOCAL DEVELOPMENT
#  Copy this file to .env. As it stands it is already correct for `npm run dev`:
#  nothing needs filling in.
# ==============================================================================

# Origin of the NexusAI backend: scheme and host only, no /api/v1 and no
# trailing slash — the client appends the path itself.
#
# Empty is the local answer. `npm run dev` then proxies /api to
# DEV_API_PROXY_TARGET below, which keeps requests same-origin and so keeps the
# auth cookies first-party — that is what lets a development backend issue
# SameSite=Lax cookies over plain HTTP. Pointing this at a local backend
# instead would make every request cross-site and sign-in would stop working.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api. Change it if your backend runs on another
# port. Never reaches the browser: no VITE_ prefix, so Vite does not inline it,
# and it is read in vite.config.ts alone.
DEV_API_PROXY_TARGET=http://127.0.0.1:3003


# ==============================================================================
#  SECTION 2 — DEPLOYMENT (frontend on Vercel, backend on Render)
#
#  One line, ready to paste into
#      Vercel -> your project -> Settings -> Environment Variables
#  Strip the leading "# ", then replace <your-api> with your Render service.
#
#  Vite inlines this at BUILD time, so it must be set BEFORE the build runs.
#  Adding or changing it does nothing to an already-deployed bundle — you have
#  to redeploy for a new value to take effect.
#
#  DEV_API_PROXY_TARGET is deliberately absent: the dev proxy does not exist in
#  a production build, so setting it on Vercel would have no effect.
# ==============================================================================

# VITE_API_BASE_URL=https://<your-api>.onrender.com

# The backend must allow this frontend's origin, or the browser blocks every
# call before it leaves. On Render set, from backend/.env.example SECTION 2:
#   CORS_ORIGINS=https://<your-app>.vercel.app
#   APP_ORIGIN=https://<your-app>.vercel.app
#   NODE_ENV=production
