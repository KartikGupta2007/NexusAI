# ==============================================================================
#  SECTION 1 — LOCAL DEVELOPMENT
#  Copy this file to .env and fill in the blanks. A blank line means "not set":
#  every optional variable here can be left empty and the server still boots.
# ==============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3003
HOST=127.0.0.1

# Comma-separated origin allowlist. Credentialed CORS cannot use "*", so every
# frontend origin that may call this API has to be named explicitly.
CORS_ORIGINS=http://localhost:5173

# ── Split deployment (frontend and API on different hosts) ────────────────────
# Both are for deployment only — leave them unset locally, where the Vite proxy
# keeps everything same-origin. See SECTION 2 for the deployed values.
#
# APP_ORIGIN — where the FRONTEND is served. Google sign-in returns the browser
#   here. Defaults to the first CORS_ORIGINS entry, which is what local wants.
# API_ORIGIN — this BACKEND's own public origin. Set it when the browser reaches
#   the API directly, so the OAuth callback URL is a fixed value rather than one
#   read off a forwarded Host header. Register it with Neon Auth's trusted
#   domains as well.
# APP_ORIGIN=
# API_ORIGIN=

# Only set when the API and frontend share a parent domain (e.g. .nexusai.app).
# Leave unset for Vercel + Render: they have no common parent, so a scoped
# cookie would simply never be sent.
# COOKIE_DOMAIN=

# ── Neon / Lakebase Postgres ──────────────────────────────────────────────────
# Populated by `neon checkout <branch>` (or `neon env pull`).
# DATABASE_URL is the -pooler endpoint used for request traffic.
# DATABASE_URL_UNPOOLED is the direct endpoint, required for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# ── Neon Auth (Managed Better Auth) — powers Google sign-in ───────────────────
# Also populated by `neon env pull`. JWKS URL is derived from the base URL if omitted.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# ── NexusAI session tokens ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

BCRYPT_SALT_ROUNDS=12
SIGNUP_CREDITS=500

# ── Third-party APIs ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Required for web search. Without it the app still boots and every non-search feature
# works; a search request fails with 503 SEARCH_NOT_CONFIGURED rather than degrading to
# Tavily's rate-limited keyless mode.
TAVILY_API_KEY=

# ── Local embeddings (BAAI BGE-M3 via @huggingface/transformers) ───────────────
# No API key: the model runs in-process. Weights are downloaded once on the first
# embedding call (~570 MB, int8) and reused from disk afterwards.
# Optional. Defaults to backend/.model-cache — set only to relocate the cache.
# EMBEDDING_CACHE_DIR=


# ==============================================================================
#  SECTION 2 — DEPLOYMENT (backend on Render, frontend on Vercel)
#
#  One block of KEY=value lines, ready to paste into
#      Render -> your service -> Environment -> Add from .env
#  Strip the leading "# " from the block first (find & replace "# " with ""),
#  then replace the four <angle-bracket> placeholders with your real values.
#
#  Three lines differ from local development and all three matter:
#    NODE_ENV=production  makes the session cookies SameSite=None; Secure, the
#                         only form a browser sends cross-site. Both hosts must
#                         be HTTPS, which Render and Vercel both are.
#    HOST=0.0.0.0         Render routes to the container's external interface;
#                         the local 127.0.0.1 default is unreachable there and
#                         the deploy fails its health check.
#    APP_ORIGIN/API_ORIGIN  the two hosts are no longer the same one.
#
#  PORT is deliberately absent: Render sets it, and overriding it breaks the
#  health check. COOKIE_DOMAIN is absent for the reason given in SECTION 1.
# ==============================================================================

# NODE_ENV=production
# HOST=0.0.0.0
# CORS_ORIGINS=https://<your-app>.vercel.app
# APP_ORIGIN=https://<your-app>.vercel.app
# API_ORIGIN=https://<your-api>.onrender.com
# DATABASE_URL=<neon pooled connection string>
# DATABASE_URL_UNPOOLED=<neon direct connection string>
# NEON_BRANCH=production
# NEON_AUTH_BASE_URL=<neon auth base url>
# NEON_AUTH_JWKS_URL=
# ACCESS_TOKEN_SECRET=<openssl rand -base64 48>
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_SECRET=<openssl rand -base64 48>
# REFRESH_TOKEN_EXPIRY=10d
# BCRYPT_SALT_ROUNDS=12
# SIGNUP_CREDITS=500
# ANTHROPIC_API_KEY=<anthropic api key>
# TAVILY_API_KEY=<tavily api key>

# Two things that live outside this file:
#   - Neon Auth trusted domains must include API_ORIGIN, or Google sign-in is
#     refused before it starts.
#   - Vercel preview deployments get a fresh URL each time and are NOT in
#     CORS_ORIGINS, so auth fails there. Add the stable branch alias if you
#     want previews working against this API.
